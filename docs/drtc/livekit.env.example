# BENCH ONLY — for running the drtc entrypoints by hand (python -m
# makermodslab.drtc.robot_sync / .policy) against some LiveKit server. Copy to
# livekit.env under MAKERMODSLAB_HOME (config.DRTC_ENV_PATH). The Lab's server
# NEVER reads this file: a session resolves url, room and every participant's
# token from its own SFU (makermodslab --sfu) and hands them over explicitly.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_ROOM=mml-bench
# Either a pre-signed token for this room and identity ...
LIVEKIT_TOKEN=
# ... or the server's API key pair to mint one from (the bench fallback).
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# This file holds ONLY the LiveKit connection. ALL behaviour config is set on
# the COMMAND LINE (no env-var fallback):
#   robot  : python -m makermodslab.drtc.robot_sync --fps 30 --horizon 16 --video_codec H264 ...
#   policy : python -m makermodslab.drtc.policy --policy-path <...> --fps 30 --horizon 16 ...
# --fps / --horizon / --video-codec MUST match on both sides.
