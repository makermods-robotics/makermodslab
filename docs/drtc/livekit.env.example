# Copy to ~/.cache/huggingface/lerobot/livekit.env and fill in your LiveKit
# credentials (config.DRTC_ENV_PATH). The Modal side reads the SAME four values
# from the `LiveKit-cloud` Modal secret — url / key / secret / room must match.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=portal-lerobot-inference

# This file holds ONLY the LiveKit connection. ALL behaviour config is set on
# the COMMAND LINE (no env-var fallback):
#   robot  : python -m makermodslab.drtc.robot_sync --fps 30 --horizon 16 --video_codec H264 ...
#   policy : modal run makermodslab/drtc/modal_policy.py --policy-path <...> --fps 30 --horizon 16 ...
# --fps / --horizon / --video-codec MUST match on both sides.
