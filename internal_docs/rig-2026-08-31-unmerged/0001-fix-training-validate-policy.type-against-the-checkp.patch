+        "WARNING 2026-07-29 10:00:01     utils.py:91 Missing key(s) when loading "
+        "model: ['model.backbone.bn1.bias', 'model.action_head.weight']",
+        "WARNING 2026-07-29 10:00:01     utils.py:93 Unexpected key(s) when loading "
